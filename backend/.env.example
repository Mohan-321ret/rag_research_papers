# ---- Application ----
APP_NAME="DAA-RAG Backend"
ENVIRONMENT=development            # development | staging | production | test
DEBUG=false
API_V1_PREFIX=/api/v1

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false                     # true => JSON logs (always JSON in production)

# ---- PostgreSQL (async SQLAlchemy URL) ----
# This project's own database. Do not point it at another project's DB.
DATABASE_URL=postgresql+asyncpg://daarag:daarag@localhost:5432/rag_research_paper
DATABASE_ECHO=false

# ---- Neo4j knowledge graph ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=daarag-neo4j
GRAPH_AUTO_SYNC=true               # mirror documents into Neo4j after processing

# ---- Auth ----
# Simple flow: one signed access token, 7-day expiry, no refresh tokens.
# Generate the secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Ingestion ----
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25
OCR_ENABLED=true                   # needs the Tesseract binary installed

# ---- Processing (chunking + embeddings) ----
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_DIR=data/vector_index
CHUNK_TARGET_TOKENS=300
CHUNK_OVERLAP_SENTENCES=1
AUTO_PROCESS_ON_UPLOAD=true

# ---- Incremental re-indexing (Phase 14) ----
# true  = embed only chunks whose content actually changed (default)
# false = full-rebuild ablation baseline (re-embed every chunk)
INCREMENTAL_REINDEX_ENABLED=true

# ---- Retrieval (baseline RAG) ----
RETRIEVAL_MIN_SCORE=0.2

# ---- Enterprise LLM (Module 8) ----
# "auto" prefers Anthropic when ANTHROPIC_API_KEY is set, else Ollama
# (this module's zero-credential local default), else the extractive
# baseline. Force one explicitly with ollama | anthropic | extractive.
LLM_PROVIDER=auto
LLM_MAX_TOKENS=1024

LLM_MODEL=claude-opus-5             # used when the Anthropic provider is active
# ANTHROPIC_API_KEY=sk-ant-...      # enables the Anthropic provider (auto mode)

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b              # any pulled model: llama3.2, gemma2, mistral, ...
OLLAMA_TIMEOUT_SECONDS=60

# ---- Context fusion (dedup -> rerank -> compression -> context builder) ----
RETRIEVAL_CANDIDATE_K=20           # candidate pool fetched before fusion
CONTEXT_TOP_K=6                    # final chunks sent to the LLM (spec range: 5-8)
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Evidence verification (Module 9) ----
VERIFICATION_ENABLED=true
VERIFICATION_MODEL_NAME=cross-encoder/nli-deberta-v3-xsmall
VERIFICATION_SUPPORT_THRESHOLD=0.5
VERIFICATION_MIN_EVIDENCE_SCORE=0.2

# ---- Knowledge evolution (Module 3) ----
EVOLUTION_ENABLED=true
EVOLUTION_CONFLICT_THRESHOLD=0.5

# ---- Concept drift detection (Phase 12) ----
CONCEPT_DRIFT_THRESHOLD=0.15

# ---- Knowledge conflict detection (Phase 13) ----
CONFLICT_DETECTION_ENABLED=true
CONFLICT_SIMILARITY_THRESHOLD=0.5
CONFLICT_CONTRADICTION_THRESHOLD=0.5

# ---- CORS (comma-separated origins of the frontend) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
